VITE_APP_NAME=Lumina Market
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,ar
VITE_PLATZI_API_URL=https://api.escuelajs.co/api/v1

# Optional managed chat endpoint (no secrets in VITE_*)
# POST { "message": "...", "locale": "en"|"ar" } → { "text": "...", "suggestions"?: string[] }
# VITE_CHAT_API_URL=

# Optional hero background video (Mixkit free license by default)
# VITE_HERO_VIDEO_URL=https://assets.mixkit.co/videos/25516/25516-720.mp4
# VITE_HERO_VIDEO_URL_FALLBACK=https://assets.mixkit.co/videos/25516/25516-360.mp4

# Maps — OpenStreetMap + Leaflet + Nominatim + OSRM (no Google/Mapbox keys)
VITE_MAP_PROVIDER=osm
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
# VITE_OSRM_URL=https://router.project-osrm.org
# VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional fulfillment origin used for delivery distance / ETA (defaults: Damascus)
# VITE_FULFILLMENT_LAT=33.5138
# VITE_FULFILLMENT_LNG=36.2765

# Optional managed integrations
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_PAYPAL_CLIENT_ID=
